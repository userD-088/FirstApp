<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net9.0-android</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>FirstApp</RootNamespace>

		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>

		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<ApplicationTitle>Resistor Calculator</ApplicationTitle>
		<ApplicationId>com.companyname.firstapp</ApplicationId>

		<ApplicationDisplayVersion>0.7.2</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release'">

		<AndroidPackageFormat>aab</AndroidPackageFormat>
		<RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>

		<MauiLinkMode>Full</MauiLinkMode>
		<AndroidEnableR8>true</AndroidEnableR8>
		<RunAOTCompilation>false</RunAOTCompilation>

		<DebugSymbols>false</DebugSymbols>
		<DebugType>none</DebugType>

		<InvariantGlobalization>false</InvariantGlobalization>

		<AndroidIncludeAllLocales>true</AndroidIncludeAllLocales>

		<PublishTrimmed>true</PublishTrimmed>
		<AndroidStripNativeLibraries>true</AndroidStripNativeLibraries>

		<AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
		<AndroidUseSharedRuntime>false</AndroidUseSharedRuntime>

		<DebuggerSupport>false</DebuggerSupport>
		<EventSourceSupport>false</EventSourceSupport>
		<MetricsSupport>false</MetricsSupport>
		<HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>

	</PropertyGroup>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.png" Color="#0F172A" ForegroundScale="0.65" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0F172A" BaseSize="128,128" />

		<MauiImage Include="Resources\Images\*" />
		<MauiImage Include="Resources\Images\Flags\*" />

		<MauiFont Include="Resources\Fonts\*" />

		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
		<MauiAsset Include="Resources\Localization\*.json" LogicalName="%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="9.0.0" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.0" />
		<PackageReference Include="Microsoft.Maui.Graphics" Version="9.0.0" />
	</ItemGroup>

</Project>
