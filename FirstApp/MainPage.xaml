<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FirstApp.MainPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#000000">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#000000" Offset="0.0"/>
            <GradientStop Color="#1A2A3F" Offset="0.5"/>
            <GradientStop Color="#203A53" Offset="1.0"/>
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid>

        <!-- ===== MAIN CONTENT ===== -->
        <ScrollView>
            <VerticalStackLayout Spacing="0">

                <!-- HEADER -->
                <Border Padding="15,40,15,22" StrokeThickness="0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#0F172A" Offset="0"/>
                            <GradientStop Color="#1E293B" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid ColumnDefinitions="44,*,44">
                        <ContentView Grid.Column="0"/>
                        <VerticalStackLayout Grid.Column="1" Spacing="3"
                                             HorizontalOptions="Center">
                            <!-- FontSize bound to VM – shrinks for long translated strings -->
                            <Label Text="{Binding TitleText}"
                                   FontSize="{Binding TitleFontSize}"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center"
                                   LineBreakMode="WordWrap"/>
                            <Label Text="{Binding SubtitleText}"
                                   FontSize="13" TextColor="#94A3B8"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center"
                                   LineBreakMode="TailTruncation"/>
                        </VerticalStackLayout>
                        <Button Grid.Column="2" Text="⚙" FontSize="20"
                                BackgroundColor="Transparent" TextColor="#94A3B8"
                                WidthRequest="44" HeightRequest="44" Padding="0"
                                VerticalOptions="Center" Clicked="OnOpenSettings"/>
                    </Grid>
                </Border>

                <!-- RESISTOR PREVIEW -->
                <Border Margin="20,12" Padding="20,14"
                        StrokeShape="RoundRectangle 28"
                        Stroke="#2563EB" StrokeThickness="1.5">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#020617" Offset="0"/>
                            <GradientStop Color="#0F172A" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{Binding ModeLabelText}"
                               FontSize="16" FontAttributes="Bold"
                               TextColor="#E2E8F0" HorizontalOptions="Center"/>
                        <GraphicsView x:Name="ResistorView"
                                      HeightRequest="80" WidthRequest="300"
                                      HorizontalOptions="Center">
                            <GraphicsView.GestureRecognizers>
                                <PanGestureRecognizer PanUpdated="OnResistorPan"/>
                            </GraphicsView.GestureRecognizers>
                        </GraphicsView>
                        <Label Text="{Binding SwipeTypeHint}"
                               FontSize="12" TextColor="#475569"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>

                <!-- INPUT PANEL -->
                <Border Margin="20,0,20,30" Padding="18,16"
                        StrokeShape="RoundRectangle 24"
                        BackgroundColor="#0D1520"
                        Stroke="#2563EB" StrokeThickness="1.5">
                    <VerticalStackLayout Spacing="14">

                        <!-- Swipeable mode header -->
                        <ContentView x:Name="InputModeTitleContainer"
                                     BackgroundColor="Transparent">
                            <ContentView.GestureRecognizers>
                                <PanGestureRecognizer PanUpdated="OnInputPan"/>
                            </ContentView.GestureRecognizers>
                            <VerticalStackLayout Spacing="3">
                                <Label Text="{Binding InputModeTitleText}"
                                       FontSize="17" FontAttributes="Bold"
                                       TextColor="White" HorizontalOptions="Center"/>
                                <Label Text="{Binding SwipeInputHint}"
                                       FontSize="11" TextColor="#475569"
                                       HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </ContentView>

                        <BoxView HeightRequest="1" BackgroundColor="#1E2D40"/>

                        <!-- VALUE → COLOR -->
                        <VerticalStackLayout x:Name="ValueToColorLayout"
                                             IsVisible="{Binding IsValueMode}"
                                             Spacing="14">
                            <VerticalStackLayout Spacing="5">
                                <Label Text="{Binding ResistanceLabelText}"
                                       FontSize="13" TextColor="#9CA3AF"/>
                                <Entry x:Name="ResistanceEntry"
                                       Placeholder="e.g. 4k7 or 470"
                                       Keyboard="Numeric"
                                       BackgroundColor="#111827"
                                       TextColor="White"
                                       PlaceholderColor="#4B5563"
                                       HeightRequest="46" FontSize="15"
                                       TextChanged="OnResistanceTextChanged"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="6">
                                <Label Text="{Binding NormSeriesLabelText}"
                                       FontSize="13" TextColor="#9CA3AF"/>
                                <ScrollView Orientation="Horizontal"
                                            HorizontalScrollBarVisibility="Never">
                                    <HorizontalStackLayout x:Name="SeriesChipsMain"
                                                           Spacing="8" Padding="2,2"/>
                                </ScrollView>
                            </VerticalStackLayout>
                        </VerticalStackLayout>

                        <!-- COLOR → VALUE
                             Each row is its own element so IsVisible
                             collapses it correctly without Grid issues. -->
                        <VerticalStackLayout x:Name="ColorToValueLayout"
                                             IsVisible="{Binding IsColorMode}"
                                             Spacing="10">

                            <Label Text="{Binding ResultText}"
                                   FontSize="26" FontAttributes="Bold"
                                   TextColor="#10B981" HorizontalOptions="Center"
                                   Margin="0,2,0,4"/>

                            <!-- Ring 1 -->
                            <Grid ColumnDefinitions="58,*" ColumnSpacing="6">
                                <Label Grid.Column="0"
                                       Text="{Binding Ring1Text}"
                                       FontSize="12" TextColor="#64748B"
                                       VerticalOptions="Center"/>
                                <ScrollView Grid.Column="1" Orientation="Horizontal"
                                            HorizontalScrollBarVisibility="Never">
                                    <HorizontalStackLayout x:Name="Band1ChipsLayout"
                                                           Spacing="6" Padding="2,2"/>
                                </ScrollView>
                            </Grid>

                            <!-- Ring 2 -->
                            <Grid ColumnDefinitions="58,*" ColumnSpacing="6">
                                <Label Grid.Column="0"
                                       Text="{Binding Ring2Text}"
                                       FontSize="12" TextColor="#64748B"
                                       VerticalOptions="Center"/>
                                <ScrollView Grid.Column="1" Orientation="Horizontal"
                                            HorizontalScrollBarVisibility="Never">
                                    <HorizontalStackLayout x:Name="Band2ChipsLayout"
                                                           Spacing="6" Padding="2,2"/>
                                </ScrollView>
                            </Grid>

                            <!-- Ring 3 – separate element, collapses cleanly -->
                            <Grid IsVisible="{Binding Ring3Visible}"
                                  ColumnDefinitions="58,*" ColumnSpacing="6">
                                <Label Grid.Column="0"
                                       Text="{Binding Ring3Text}"
                                       FontSize="12" TextColor="#64748B"
                                       VerticalOptions="Center"/>
                                <ScrollView Grid.Column="1" Orientation="Horizontal"
                                            HorizontalScrollBarVisibility="Never">
                                    <HorizontalStackLayout x:Name="Band3ChipsLayout"
                                                           Spacing="6" Padding="2,2"/>
                                </ScrollView>
                            </Grid>

                            <!-- Multiplier -->
                            <Grid ColumnDefinitions="58,*" ColumnSpacing="6">
                                <Label Grid.Column="0"
                                       Text="{Binding MultText}"
                                       FontSize="12" TextColor="#64748B"
                                       VerticalOptions="Center"/>
                                <ScrollView Grid.Column="1" Orientation="Horizontal"
                                            HorizontalScrollBarVisibility="Never">
                                    <HorizontalStackLayout x:Name="MultiplierChipsLayout"
                                                           Spacing="6" Padding="2,2"/>
                                </ScrollView>
                            </Grid>

                        </VerticalStackLayout>

                        <BoxView HeightRequest="1" BackgroundColor="#1E2D40"/>

                        <!-- Tolerance chips (always visible) -->
                        <Grid ColumnDefinitions="58,*" ColumnSpacing="6">
                            <Label Grid.Column="0"
                                   Text="{Binding TolText}"
                                   FontSize="12" TextColor="#64748B"
                                   VerticalOptions="Center"/>
                            <ScrollView Grid.Column="1" Orientation="Horizontal"
                                        HorizontalScrollBarVisibility="Never">
                                <HorizontalStackLayout x:Name="ToleranceChipsLayout"
                                                       Spacing="6" Padding="2,2"/>
                            </ScrollView>
                        </Grid>

                        <!-- TCR chips (6-Band only) -->
                        <Grid IsVisible="{Binding TcrVisible}"
                              ColumnDefinitions="58,*" ColumnSpacing="6">
                            <Label Grid.Column="0"
                                   Text="{Binding TcrText}"
                                   FontSize="12" TextColor="#64748B"
                                   VerticalOptions="Center"/>
                            <ScrollView Grid.Column="1" Orientation="Horizontal"
                                        HorizontalScrollBarVisibility="Never">
                                <HorizontalStackLayout x:Name="TcrChipsLayout"
                                                       Spacing="6" Padding="2,2"/>
                            </ScrollView>
                        </Grid>

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ===== SETTINGS OVERLAY ===== -->
        <Grid x:Name="SettingsOverlay" IsVisible="False"
              BackgroundColor="#BB000000">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnSettingsBackdropTapped"/>
            </Grid.GestureRecognizers>

            <Border x:Name="SettingsPanel"
                    VerticalOptions="End"
                    StrokeShape="RoundRectangle 28,28,0,0"
                    Stroke="#2563EB" StrokeThickness="1.5"
                    Padding="24,12,24,44">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#0F172A" Offset="0"/>
                        <GradientStop Color="#1A2A3F" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSettingsPanelTapped"/>
                </Border.GestureRecognizers>

                <VerticalStackLayout Spacing="20">
                    <BoxView WidthRequest="40" HeightRequest="4" CornerRadius="2"
                             BackgroundColor="#334155" HorizontalOptions="Center"
                             Margin="0,4,0,0"/>

                    <Label Text="{Binding SettingsTitleText}"
                           FontSize="20" FontAttributes="Bold"
                           TextColor="White" HorizontalOptions="Center"/>

                    <!-- Language chips -->
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{Binding LangSectionText}"
                               FontSize="13" TextColor="#9CA3AF"/>
                        <ScrollView Orientation="Horizontal"
                                    HorizontalScrollBarVisibility="Never">
                            <HorizontalStackLayout x:Name="LangChipsLayout"
                                                   Spacing="8" Padding="2,4"/>
                        </ScrollView>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" BackgroundColor="#1E293B"/>

                    <!-- About -->
                    <Border Padding="16,14" StrokeShape="RoundRectangle 16"
                            BackgroundColor="#111827" Stroke="#1E293B" StrokeThickness="1">
                        <VerticalStackLayout Spacing="5">
                            <Label Text="{Binding AboutTitleText}"
                                   FontSize="14" FontAttributes="Bold" TextColor="#E2E8F0"/>
                            <!-- FIX: Version wird jetzt aus AppInfo.VersionString gelesen (csproj) -->
                            <Label Text="{Binding AppVersionText}"
                                   FontSize="13" TextColor="#94A3B8"/>
                            <Label Text="{Binding AboutDescText}"
                                   FontSize="12" TextColor="#6B7280"/>
                            <BoxView HeightRequest="1" BackgroundColor="#1E293B" Margin="0,5"/>
                            <Label Text="{Binding CopyrightText}"
                                   FontSize="11" TextColor="#374151"/>
                        </VerticalStackLayout>
                    </Border>

                    <Button Text="{Binding CloseText}"
                            Clicked="OnCloseSettings"
                            BackgroundColor="#2563EB" TextColor="White"
                            CornerRadius="16" HeightRequest="50" FontSize="16"/>
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>
