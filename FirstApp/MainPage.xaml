<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FirstApp.MainPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#000000">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#000000" Offset="0.0"/>
            <GradientStop Color="#1A2A3F" Offset="0.5"/>
            <GradientStop Color="#203A53" Offset="1.0"/>
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid>
        <ScrollView>
            <VerticalStackLayout Spacing="0">

                <!-- ══ HEADER ══ -->
                <Border Padding="15,40,15,22" StrokeThickness="0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#0F172A" Offset="0"/>
                            <GradientStop Color="#1E293B" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid ColumnDefinitions="44,*,44">
                        <ContentView Grid.Column="0"/>
                        <VerticalStackLayout Grid.Column="1" Spacing="3" HorizontalOptions="Center">
                            <Label Text="{Binding TitleText}"
                                   FontSize="{Binding TitleFontSize}"
                                   FontAttributes="Bold" TextColor="White"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center"
                                   LineBreakMode="WordWrap"/>
                            <Label Text="{Binding SubtitleText}"
                                   FontSize="13" TextColor="#94A3B8"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center"
                                   LineBreakMode="TailTruncation"/>
                        </VerticalStackLayout>
                        <Button Grid.Column="2" Text="⚙" FontSize="20"
                                BackgroundColor="Transparent" TextColor="#94A3B8"
                                WidthRequest="44" HeightRequest="44" Padding="0"
                                VerticalOptions="Center" Clicked="OnOpenSettings"/>
                    </Grid>
                </Border>

                <!-- ══ RESISTOR CARD ══ -->
                <Border Margin="20,12" Padding="16,14"
                        StrokeShape="RoundRectangle 28"
                        Stroke="#2563EB" StrokeThickness="1.5">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#020617" Offset="0"/>
                            <GradientStop Color="#0F172A" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <VerticalStackLayout Spacing="12">

                        <!-- Segmented control – Widerstandstyp -->
                        <Border BackgroundColor="#060D1A"
                                StrokeShape="RoundRectangle 13"
                                Stroke="#1E3A5F" StrokeThickness="1"
                                Padding="3">
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="3">
                                <Border x:Name="ResTab0" Grid.Column="0"
                                        BackgroundColor="#1A2535"
                                        StrokeShape="RoundRectangle 10" Padding="6,9">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnResTab0Tapped"/>
                                    </Border.GestureRecognizers>
                                    <Label x:Name="ResTabLabel0" Text="{Binding Band4BtnText}"
                                           FontSize="11" TextColor="#64748B" MaxLines="1"
                                           LineBreakMode="TailTruncation"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center"/>
                                </Border>
                                <Border x:Name="ResTab1" Grid.Column="1"
                                        BackgroundColor="#2563EB"
                                        StrokeShape="RoundRectangle 10" Padding="6,9">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnResTab1Tapped"/>
                                    </Border.GestureRecognizers>
                                    <Label x:Name="ResTabLabel1" Text="{Binding Band5BtnText}"
                                           FontSize="11" FontAttributes="Bold" TextColor="White"
                                           MaxLines="1" LineBreakMode="TailTruncation"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center"/>
                                </Border>
                                <Border x:Name="ResTab2" Grid.Column="2"
                                        BackgroundColor="#1A2535"
                                        StrokeShape="RoundRectangle 10" Padding="6,9">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnResTab2Tapped"/>
                                    </Border.GestureRecognizers>
                                    <Label x:Name="ResTabLabel2" Text="{Binding Band6BtnText}"
                                           FontSize="11" TextColor="#64748B" MaxLines="1"
                                           LineBreakMode="TailTruncation"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Resistor-Grafik – Container für Slide-Animation -->
                        <Grid x:Name="ResistorViewContainer"
                              HeightRequest="80" WidthRequest="300"
                              HorizontalOptions="Center"
                              IsClippedToBounds="True">
                            <GraphicsView x:Name="ResistorView"/>
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- ══ INPUT CARD ══ -->
                <Border Margin="20,0,20,30" Padding="18,16"
                        StrokeShape="RoundRectangle 24"
                        BackgroundColor="#0D1520"
                        Stroke="#2563EB" StrokeThickness="1.5">
                    <VerticalStackLayout Spacing="14">

                        <!-- Segmented control – Eingabe-Modus -->
                        <Border BackgroundColor="#060D1A"
                                StrokeShape="RoundRectangle 13"
                                Stroke="#1E3A5F" StrokeThickness="1"
                                Padding="3">
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="3">
                                <Border x:Name="InputTab0" Grid.Column="0"
                                        BackgroundColor="#2563EB"
                                        StrokeShape="RoundRectangle 10" Padding="8,9">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnInputTab0Tapped"/>
                                    </Border.GestureRecognizers>
                                    <Label x:Name="InputTabLabel0" Text="{Binding ValToColTabText}"
                                           FontSize="12" FontAttributes="Bold" TextColor="White"
                                           MaxLines="1" LineBreakMode="TailTruncation"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center"/>
                                </Border>
                                <Border x:Name="InputTab1" Grid.Column="1"
                                        BackgroundColor="Transparent"
                                        StrokeShape="RoundRectangle 10" Padding="8,9">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnInputTab1Tapped"/>
                                    </Border.GestureRecognizers>
                                    <Label x:Name="InputTabLabel1" Text="{Binding ColToValTabText}"
                                           FontSize="12" TextColor="#64748B"
                                           MaxLines="1" LineBreakMode="TailTruncation"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>

                        <BoxView HeightRequest="1" BackgroundColor="#1E2D40"/>

                        <!-- Animierter Inhaltsbereich -->
                        <Grid x:Name="InputContentGrid" IsClippedToBounds="True">

                            <!-- VALUE → COLOR -->
                            <VerticalStackLayout x:Name="ValueToColorLayout"
                                                 IsVisible="{Binding IsValueMode}"
                                                 Spacing="14">
                                <VerticalStackLayout Spacing="5">
                                    <Label Text="{Binding ResistanceLabelText}"
                                           FontSize="13" TextColor="#9CA3AF"/>
                                    <Entry x:Name="ResistanceEntry"
                                           Placeholder="e.g. 4k7 or 470"
                                           Keyboard="Numeric"
                                           BackgroundColor="#111827" TextColor="White"
                                           PlaceholderColor="#4B5563"
                                           HeightRequest="46" FontSize="15"
                                           TextChanged="OnResistanceTextChanged"/>
                                </VerticalStackLayout>
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="{Binding NormSeriesLabelText}"
                                           FontSize="13" TextColor="#9CA3AF"/>
                                    <ScrollView Orientation="Horizontal"
                                                HorizontalScrollBarVisibility="Never">
                                        <HorizontalStackLayout x:Name="SeriesChipsMain"
                                                               Spacing="8" Padding="2,2"/>
                                    </ScrollView>
                                </VerticalStackLayout>
                            </VerticalStackLayout>

                            <!-- COLOR → VALUE -->
                            <VerticalStackLayout x:Name="ColorToValueLayout"
                                                 IsVisible="{Binding IsColorMode}"
                                                 Spacing="10">
                                <Label Text="{Binding ResultText}"
                                       FontSize="26" FontAttributes="Bold"
                                       TextColor="#10B981" HorizontalOptions="Center"
                                       Margin="0,2,0,4"/>
                                <Grid ColumnDefinitions="58,*" ColumnSpacing="6">
                                    <Label Grid.Column="0" Text="{Binding Ring1Text}"
                                           FontSize="12" TextColor="#64748B" VerticalOptions="Center"/>
                                    <ScrollView Grid.Column="1" Orientation="Horizontal"
                                                HorizontalScrollBarVisibility="Never">
                                        <HorizontalStackLayout x:Name="Band1ChipsLayout"
                                                               Spacing="6" Padding="2,2"/>
                                    </ScrollView>
                                </Grid>
                                <Grid ColumnDefinitions="58,*" ColumnSpacing="6">
                                    <Label Grid.Column="0" Text="{Binding Ring2Text}"
                                           FontSize="12" TextColor="#64748B" VerticalOptions="Center"/>
                                    <ScrollView Grid.Column="1" Orientation="Horizontal"
                                                HorizontalScrollBarVisibility="Never">
                                        <HorizontalStackLayout x:Name="Band2ChipsLayout"
                                                               Spacing="6" Padding="2,2"/>
                                    </ScrollView>
                                </Grid>
                                <Grid IsVisible="{Binding Ring3Visible}"
                                      ColumnDefinitions="58,*" ColumnSpacing="6">
                                    <Label Grid.Column="0" Text="{Binding Ring3Text}"
                                           FontSize="12" TextColor="#64748B" VerticalOptions="Center"/>
                                    <ScrollView Grid.Column="1" Orientation="Horizontal"
                                                HorizontalScrollBarVisibility="Never">
                                        <HorizontalStackLayout x:Name="Band3ChipsLayout"
                                                               Spacing="6" Padding="2,2"/>
                                    </ScrollView>
                                </Grid>
                                <Grid ColumnDefinitions="58,*" ColumnSpacing="6">
                                    <Label Grid.Column="0" Text="{Binding MultText}"
                                           FontSize="12" TextColor="#64748B" VerticalOptions="Center"/>
                                    <ScrollView Grid.Column="1" Orientation="Horizontal"
                                                HorizontalScrollBarVisibility="Never">
                                        <HorizontalStackLayout x:Name="MultiplierChipsLayout"
                                                               Spacing="6" Padding="2,2"/>
                                    </ScrollView>
                                </Grid>
                            </VerticalStackLayout>

                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="#1E2D40"/>

                        <!-- Tolerance -->
                        <Grid ColumnDefinitions="58,*" ColumnSpacing="6">
                            <Label Grid.Column="0" Text="{Binding TolText}"
                                   FontSize="12" TextColor="#64748B" VerticalOptions="Center"/>
                            <ScrollView Grid.Column="1" Orientation="Horizontal"
                                        HorizontalScrollBarVisibility="Never">
                                <HorizontalStackLayout x:Name="ToleranceChipsLayout"
                                                       Spacing="6" Padding="2,2"/>
                            </ScrollView>
                        </Grid>

                        <!-- TCR (6-Band only) -->
                        <Grid IsVisible="{Binding TcrVisible}"
                              ColumnDefinitions="58,*" ColumnSpacing="6">
                            <Label Grid.Column="0" Text="{Binding TcrText}"
                                   FontSize="12" TextColor="#64748B" VerticalOptions="Center"/>
                            <ScrollView Grid.Column="1" Orientation="Horizontal"
                                        HorizontalScrollBarVisibility="Never">
                                <HorizontalStackLayout x:Name="TcrChipsLayout"
                                                       Spacing="6" Padding="2,2"/>
                            </ScrollView>
                        </Grid>

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ══ SETTINGS OVERLAY ══
             Immer im VisualTree (IsVisible=False nur für Hit-Testing),
             Opacity gesteuert für flüssige Animation ohne Layout-Neuberechnung. -->
        <Grid x:Name="SettingsOverlay" IsVisible="False"
              InputTransparent="True"
              BackgroundColor="#BB000000">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnSettingsBackdropTapped"/>
            </Grid.GestureRecognizers>

            <Border x:Name="SettingsPanel"
                    VerticalOptions="End"
                    StrokeShape="RoundRectangle 28,28,0,0"
                    Stroke="#2563EB" StrokeThickness="1.5"
                    Padding="24,12,24,44">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#0F172A" Offset="0"/>
                        <GradientStop Color="#1A2A3F" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSettingsPanelTapped"/>
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="20">
                    <BoxView WidthRequest="40" HeightRequest="4" CornerRadius="2"
                             BackgroundColor="#334155" HorizontalOptions="Center"
                             Margin="0,4,0,0"/>
                    <Label Text="{Binding SettingsTitleText}"
                           FontSize="20" FontAttributes="Bold"
                           TextColor="White" HorizontalOptions="Center"/>
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{Binding LangSectionText}"
                               FontSize="13" TextColor="#9CA3AF"/>
                        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                            <HorizontalStackLayout x:Name="LangChipsLayout" Spacing="8" Padding="2,4"/>
                        </ScrollView>
                    </VerticalStackLayout>
                    <BoxView HeightRequest="1" BackgroundColor="#1E293B"/>
                    <Border Padding="16,14" StrokeShape="RoundRectangle 16"
                            BackgroundColor="#111827" Stroke="#1E293B" StrokeThickness="1">
                        <VerticalStackLayout Spacing="5">
                            <Label Text="{Binding AboutTitleText}"
                                   FontSize="14" FontAttributes="Bold" TextColor="#E2E8F0"/>
                            <Label Text="{Binding AppVersionText}"
                                   FontSize="13" TextColor="#94A3B8"/>
                            <Label Text="{Binding AboutDescText}"
                                   FontSize="12" TextColor="#6B7280"/>
                            <BoxView HeightRequest="1" BackgroundColor="#1E293B" Margin="0,5"/>
                            <Label Text="{Binding CopyrightText}"
                                   FontSize="11" TextColor="#374151"/>
                        </VerticalStackLayout>
                    </Border>
                    <Button Text="{Binding CloseText}" Clicked="OnCloseSettings"
                            BackgroundColor="#2563EB" TextColor="White"
                            CornerRadius="16" HeightRequest="50" FontSize="16"/>
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>
