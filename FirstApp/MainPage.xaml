<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:FirstApp"
             x:Class="FirstApp.MainPage"
             x:DataType="local:ResistorViewModel"
             BackgroundColor="#000000">

    <Grid x:Name="RootGrid">
        <ScrollView x:Name="MainScroll">
            <VerticalStackLayout Spacing="0" Padding="0,0,0,24">

                <!-- ═════════════ HEADER ═════════════ -->
                <Border x:Name="HeaderBdr" Padding="12,40,12,18" StrokeThickness="0">
                    <Grid ColumnDefinitions="48,*,48">
                        <Border Grid.Column="0" x:Name="HelpBtn"
                                WidthRequest="44" HeightRequest="44"
                                StrokeShape="RoundRectangle 22" StrokeThickness="0"
                                BackgroundColor="#14FFFFFF" VerticalOptions="Center"
                                SemanticProperties.Description="{Binding [refTitle]}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnOpenReference"/>
                            </Border.GestureRecognizers>
                            <Label Text="?" FontSize="19" FontAttributes="Bold" TextColor="#94A3B8"
                                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="3" HorizontalOptions="Center" VerticalOptions="Center">
                            <Label Text="{Binding [title]}"
                                   FontSize="{Binding TitleFontSize}"
                                   FontAttributes="Bold" TextColor="White"
                                   HorizontalTextAlignment="Center"
                                   LineBreakMode="WordWrap"/>
                            <Label Text="{Binding [subtitle]}"
                                   FontSize="13" TextColor="#94A3B8"
                                   HorizontalTextAlignment="Center"
                                   LineBreakMode="TailTruncation"/>
                        </VerticalStackLayout>
                        <Border Grid.Column="2" x:Name="SettingsBtn"
                                WidthRequest="44" HeightRequest="44"
                                StrokeShape="RoundRectangle 22" StrokeThickness="0"
                                BackgroundColor="#14FFFFFF" VerticalOptions="Center"
                                SemanticProperties.Description="{Binding [settings]}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnOpenSettings"/>
                            </Border.GestureRecognizers>
                            <Image Source="settings.svg" WidthRequest="22" HeightRequest="22"
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- ═════════════ RESISTOR CARD ═════════════ -->
                <Border x:Name="ResCardBdr" Margin="16,12,16,12" Padding="14,14,14,16"
                        StrokeShape="RoundRectangle 26" StrokeThickness="1.5">
                    <Grid>
                        <VerticalStackLayout Spacing="10">

                            <!-- band count tabs -->
                            <Border x:Name="ResTabsBdr" BackgroundColor="#060D1A"
                                    StrokeShape="RoundRectangle 13" Stroke="#1E3A5F" StrokeThickness="1" Padding="0">
                                <Grid ColumnDefinitions="*,*,*">
                                    <Border x:Name="ResTab0" Grid.Column="0" StrokeThickness="0" Padding="0,11">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnResTabTapped" CommandParameter="0"/>
                                        </Border.GestureRecognizers>
                                        <Label x:Name="ResTabLabel0" Text="{Binding [band4]}" FontSize="12" MaxLines="1"
                                               LineBreakMode="TailTruncation"
                                               HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                                    </Border>
                                    <Border x:Name="ResTab1" Grid.Column="1" StrokeThickness="0" Padding="0,11">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnResTabTapped" CommandParameter="1"/>
                                        </Border.GestureRecognizers>
                                        <Label x:Name="ResTabLabel1" Text="{Binding [band5]}" FontSize="12" MaxLines="1"
                                               LineBreakMode="TailTruncation"
                                               HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                                    </Border>
                                    <Border x:Name="ResTab2" Grid.Column="2" StrokeThickness="0" Padding="0,11">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnResTabTapped" CommandParameter="2"/>
                                        </Border.GestureRecognizers>
                                        <Label x:Name="ResTabLabel2" Text="{Binding [band6]}" FontSize="12" MaxLines="1"
                                               LineBreakMode="TailTruncation"
                                               HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- resistor graphic -->
                            <Grid x:Name="ResistorViewContainer" HeightRequest="92" IsClippedToBounds="True">
                                <GraphicsView x:Name="ResistorView"/>
                            </Grid>

                            <!-- result (tap to copy) -->
                            <VerticalStackLayout x:Name="ResultBlock" Spacing="2" Padding="4,0">
                                <VerticalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnResultTapped"/>
                                </VerticalStackLayout.GestureRecognizers>
                                <Label x:Name="ResultLabel"
                                       Text="{Binding ResultValue}"
                                       FontSize="30" FontAttributes="Bold"
                                       HorizontalTextAlignment="Center"/>
                                <Label Text="{Binding ResultDetail}"
                                       FontSize="14" FontAttributes="Bold" TextColor="#E2E8F0"
                                       HorizontalTextAlignment="Center"/>
                                <Label Text="{Binding ResultRange}" IsVisible="{Binding HasRange}"
                                       FontSize="12" TextColor="#94A3B8"
                                       HorizontalTextAlignment="Center"/>
                                <Label Text="{Binding BandNames}"
                                       FontSize="12" TextColor="#64748B" Margin="0,4,0,0"
                                       HorizontalTextAlignment="Center" LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>
                        </VerticalStackLayout>

                        <GraphicsView x:Name="ResCardCorners" InputTransparent="True" IsVisible="False"/>
                    </Grid>
                </Border>

                <!-- ═════════════ INPUT CARD ═════════════ -->
                <Border x:Name="InputCardBdr" Margin="16,0,16,0" Padding="16,14,16,16"
                        StrokeShape="RoundRectangle 24" StrokeThickness="1.5">
                    <Grid>
                        <VerticalStackLayout Spacing="14">

                            <!-- input mode tabs -->
                            <Border x:Name="InputTabsBdr" BackgroundColor="#060D1A"
                                    StrokeShape="RoundRectangle 13" Stroke="#1E3A5F" StrokeThickness="1" Padding="0">
                                <Grid ColumnDefinitions="*,*">
                                    <Border x:Name="InputTab0" Grid.Column="0" StrokeThickness="0" Padding="0,12">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnInputTabTapped" CommandParameter="0"/>
                                        </Border.GestureRecognizers>
                                        <Label x:Name="InputTabLabel0" Text="{Binding [valToCol]}" FontSize="12"
                                               MaxLines="1" LineBreakMode="TailTruncation"
                                               HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                                    </Border>
                                    <Border x:Name="InputTab1" Grid.Column="1" StrokeThickness="0" Padding="0,12">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnInputTabTapped" CommandParameter="1"/>
                                        </Border.GestureRecognizers>
                                        <Label x:Name="InputTabLabel1" Text="{Binding [colToVal]}" FontSize="12"
                                               MaxLines="1" LineBreakMode="TailTruncation"
                                               HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- animated content area -->
                            <Grid x:Name="InputContentGrid" IsClippedToBounds="True">

                                <!-- value → colour -->
                                <VerticalStackLayout x:Name="ValueToColorLayout" IsVisible="{Binding IsValueMode}" Spacing="10">
                                    <Label Text="{Binding [resistance]}" FontSize="13" TextColor="#9CA3AF"/>
                                    <Border x:Name="EntryBdr" BackgroundColor="#111827"
                                            StrokeShape="RoundRectangle 12" Stroke="#1E3A5F" StrokeThickness="1"
                                            Padding="10,0">
                                        <Entry x:Name="ResistanceEntry"
                                               Text="{Binding EntryText, Mode=TwoWay}"
                                               Placeholder="4.7 · 470 · 2.2"
                                               Keyboard="Numeric"
                                               ClearButtonVisibility="WhileEditing"
                                               BackgroundColor="Transparent" TextColor="White"
                                               PlaceholderColor="#4B5563"
                                               HeightRequest="48" FontSize="17"/>
                                    </Border>
                                    <!-- unit segments -->
                                    <Border x:Name="UnitTabsBdr" BackgroundColor="#060D1A"
                                            StrokeShape="RoundRectangle 12" Stroke="#1E3A5F" StrokeThickness="1" Padding="0">
                                        <Grid x:Name="UnitGrid" ColumnDefinitions="*,*,*,*"/>
                                    </Border>
                                </VerticalStackLayout>

                                <!-- colour → value (rows are built on first use) -->
                                <VerticalStackLayout x:Name="ColorToValueLayout" IsVisible="{Binding IsColorMode}" Spacing="10">
                                    <Grid ColumnDefinitions="64,*" ColumnSpacing="6">
                                        <Label Grid.Column="0" Text="{Binding [ring1]}" FontSize="12" TextColor="#64748B" VerticalOptions="Center"/>
                                        <ScrollView Grid.Column="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                                            <HorizontalStackLayout x:Name="Band1ChipsLayout" Spacing="6" Padding="2"/>
                                        </ScrollView>
                                    </Grid>
                                    <Grid ColumnDefinitions="64,*" ColumnSpacing="6">
                                        <Label Grid.Column="0" Text="{Binding [ring2]}" FontSize="12" TextColor="#64748B" VerticalOptions="Center"/>
                                        <ScrollView Grid.Column="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                                            <HorizontalStackLayout x:Name="Band2ChipsLayout" Spacing="6" Padding="2"/>
                                        </ScrollView>
                                    </Grid>
                                    <Grid IsVisible="{Binding Ring3Visible}" ColumnDefinitions="64,*" ColumnSpacing="6">
                                        <Label Grid.Column="0" Text="{Binding [ring3]}" FontSize="12" TextColor="#64748B" VerticalOptions="Center"/>
                                        <ScrollView Grid.Column="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                                            <HorizontalStackLayout x:Name="Band3ChipsLayout" Spacing="6" Padding="2"/>
                                        </ScrollView>
                                    </Grid>
                                    <Grid ColumnDefinitions="64,*" ColumnSpacing="6">
                                        <Label Grid.Column="0" Text="{Binding [mult]}" FontSize="12" TextColor="#64748B" VerticalOptions="Center"/>
                                        <ScrollView Grid.Column="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                                            <HorizontalStackLayout x:Name="MultiplierChipsLayout" Spacing="6" Padding="2"/>
                                        </ScrollView>
                                    </Grid>
                                </VerticalStackLayout>
                            </Grid>

                            <!-- status / hint -->
                            <Label x:Name="StatusLabel" Text="{Binding StatusText}" IsVisible="{Binding HasStatus}"
                                   FontSize="12" TextColor="#94A3B8" Margin="2,-4,2,0"/>

                            <BoxView HeightRequest="1" Color="#1E2D40"/>

                            <!-- tolerance -->
                            <Grid ColumnDefinitions="64,*" ColumnSpacing="6">
                                <Label Grid.Column="0" Text="{Binding [tol]}" FontSize="12" TextColor="#64748B" VerticalOptions="Center"/>
                                <ScrollView Grid.Column="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                                    <HorizontalStackLayout x:Name="ToleranceChipsLayout" Spacing="6" Padding="2"/>
                                </ScrollView>
                            </Grid>

                            <!-- TCR (6-band only) -->
                            <Grid IsVisible="{Binding TcrVisible}" ColumnDefinitions="64,*" ColumnSpacing="6">
                                <Label Grid.Column="0" Text="{Binding [tcr]}" FontSize="12" TextColor="#64748B" VerticalOptions="Center"/>
                                <ScrollView Grid.Column="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                                    <HorizontalStackLayout x:Name="TcrChipsLayout" Spacing="6" Padding="2"/>
                                </ScrollView>
                            </Grid>

                            <BoxView HeightRequest="1" Color="#1E2D40"/>

                            <!-- E-series -->
                            <VerticalStackLayout Spacing="8">
                                <Label Text="{Binding [normSeries]}" FontSize="13" TextColor="#9CA3AF"/>
                                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                                    <HorizontalStackLayout x:Name="SeriesChipsLayout" Spacing="8" Padding="2"/>
                                </ScrollView>
                                <Border x:Name="SuggestionBdr" IsVisible="{Binding HasSuggestion}"
                                        StrokeShape="RoundRectangle 12" StrokeThickness="1" Padding="12,10">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnSuggestionTapped"/>
                                    </Border.GestureRecognizers>
                                    <Label Text="{Binding SuggestionText}" FontSize="13" TextColor="#E2E8F0"/>
                                </Border>
                            </VerticalStackLayout>
                        </VerticalStackLayout>

                        <GraphicsView x:Name="InputCardCorners" InputTransparent="True" IsVisible="False"/>
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Cyber scanlines (moved by translation, drawn once) -->
        <GraphicsView x:Name="ScanlinesView" InputTransparent="True" IsVisible="False" Margin="0,-8,0,0"/>

        <!-- toast -->
        <Border x:Name="Toast" IsVisible="False" InputTransparent="True"
                VerticalOptions="End" HorizontalOptions="Center" Margin="24,0,24,48"
                BackgroundColor="#E6111827" Stroke="#334155" StrokeThickness="1"
                StrokeShape="RoundRectangle 18" Padding="18,10">
            <Label x:Name="ToastLabel" TextColor="White" FontSize="13" HorizontalTextAlignment="Center"/>
        </Border>

        <!-- bottom sheet host (settings / reference), content created on demand -->
        <Grid x:Name="SheetOverlay" IsVisible="False" BackgroundColor="#BB000000">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnSheetBackdropTapped"/>
            </Grid.GestureRecognizers>
            <Border x:Name="SheetPanel" VerticalOptions="End"
                    StrokeShape="RoundRectangle 28,28,0,0" StrokeThickness="1.5"
                    Padding="20,8,20,24">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSheetPanelTapped"/>
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="0">
                    <Grid x:Name="SheetHeader" RowDefinitions="Auto,Auto" Padding="0,0,0,12" BackgroundColor="Transparent">
                        <Grid.GestureRecognizers>
                            <PanGestureRecognizer PanUpdated="OnSheetPanUpdated"/>
                        </Grid.GestureRecognizers>
                        <BoxView WidthRequest="40" HeightRequest="4" CornerRadius="2"
                                 Color="#334155" HorizontalOptions="Center" Margin="0,4,0,12"/>
                        <Grid Grid.Row="1" ColumnDefinitions="*,44">
                            <Label x:Name="SheetTitle" FontSize="20" FontAttributes="Bold"
                                   TextColor="White" VerticalOptions="Center"/>
                            <Border Grid.Column="1" WidthRequest="36" HeightRequest="36"
                                    StrokeShape="RoundRectangle 18" StrokeThickness="0"
                                    BackgroundColor="#1AFFFFFF" HorizontalOptions="End"
                                    SemanticProperties.Description="{Binding [close]}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnSheetCloseTapped"/>
                                </Border.GestureRecognizers>
                                <Label Text="✕" FontSize="15" TextColor="#CBD5E1"
                                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Grid>
                    <ScrollView x:Name="SheetScroll" HorizontalScrollBarVisibility="Never"/>
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>
